{
  "expo": {
    "name": "Lüneburg Country Butchery",
    "slug": "luneburg-butchery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "luneburg",
    "userInterfaceStyle": "light",
    "primaryColor": "#1B3D2F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.wssfarming.luneburg",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lüneburg uses your location only while the app is open to suggest the nearest Point of Pickup for collection.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Lüneburg uses your location only while the app is open to suggest the nearest Point of Pickup for collection.",
        "NSUserNotificationsUsageDescription": "Lüneburg sends order updates when your parcel is confirmed, leaves the butchery, or is ready for collection at your Point of Pickup."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B3D2F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "co.wssfarming.luneburg",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B3D2F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lüneburg uses your location only while the app is open to suggest the nearest Point of Pickup for collection.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "supportEmail": "Karl@Wssfarming.co.za",
      "appleMerchantIdPlaceholder": "merchant.co.wssfarming.luneburg",
      "appleTeamIdPlaceholder": "REPLACE_WITH_APPLE_TEAM_ID",
      "testFlightContact": "Karl@Wssfarming.co.za",
      "testFlightReviewNotesPlaceholder": "PLACEHOLDER — TestFlight / App Review notes. Demo uses stub payments (EXPO_PUBLIC_PAYMENTS_MODE=stub). No live charges. Browse catalogue, add to cart, checkout with stub pay. Contact: Karl@Wssfarming.co.za"
    }
  }
}
