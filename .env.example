# Copy to .env for local Expo. Never commit real secrets.
# Client-safe EXPO_PUBLIC_* values only — processing certs / private keys stay out of the app.

# stub | sandbox | live  (TestFlight first build stays on stub)
EXPO_PUBLIC_PAYMENTS_MODE=stub

# Show the demo role switch outside a dev build. Leave unset for customer builds.
# EXPO_PUBLIC_DEMO=1

# stub | sandbox | live
EXPO_PUBLIC_NOTIFICATIONS_MODE=stub

# Suggested Merchant ID (create in Apple Developer → Identifiers → Merchant IDs)
EXPO_PUBLIC_APPLE_MERCHANT_ID=merchant.co.wssfarming.luneburg

# Yoco public/publishable key only (never the secret key in the app)
EXPO_PUBLIC_YOCO_PUBLIC_KEY=

# Backend base URL when payment / push APIs exist
EXPO_PUBLIC_API_BASE_URL=

# From `eas init` / expo.dev project settings
EXPO_PUBLIC_EAS_PROJECT_ID=

# --- Local EAS / submit helpers (not baked into the binary; use EAS Secrets or shell env) ---
# EXPO_TOKEN=
# EXPO_APPLE_ID=
# EXPO_APPLE_APP_SPECIFIC_PASSWORD=
# ASC_API_KEY_PATH=
# ASC_API_KEY_ID=
# ASC_API_KEY_ISSUER_ID=
