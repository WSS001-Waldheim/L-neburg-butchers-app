# Copy to .env for local Expo. Never commit real secrets.
# Client-safe EXPO_PUBLIC_* values only — processing certs / private keys stay out of the app.

# sandbox = Yoco test keys (pk_test_ / sk_test_). live = pk_live_ / sk_live_.
# Leave sandbox until Karl switches the shop to live cards.
EXPO_PUBLIC_PAYMENTS_MODE=sandbox

# Optional. Empty until Karl confirms the real cut-off.
# Example once confirmed: Wednesday 12:00 SAST
EXPO_PUBLIC_ORDER_CUTOFF=

# Show the demo role switch outside a dev build. Leave unset for customer builds.
# EXPO_PUBLIC_DEMO=1

# stub | sandbox | live
EXPO_PUBLIC_NOTIFICATIONS_MODE=stub

# Suggested Merchant ID (create in Apple Developer → Identifiers → Merchant IDs)
EXPO_PUBLIC_APPLE_MERCHANT_ID=merchant.co.wssfarming.luneburg

# Yoco public key (YOCO_PUBLIC_KEY). Expo inlines only EXPO_PUBLIC_* into the app.
# Start with the test key pk_test_… Never put sk_ or whsec_ here.
EXPO_PUBLIC_YOCO_PUBLIC_KEY=

# Supabase project hnhmfnundobuarvfbaae (eu-central-1).
# The URL is public. The anon key is the publishable key from Project Settings → API.
# Both must be set or the shop stays on the in-memory seed.
# The service role key is not an app variable. Supabase injects it into Edge Functions.
EXPO_PUBLIC_SUPABASE_URL=https://hnhmfnundobuarvfbaae.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin Yoco should return to when the app is not running in a browser.
# On the web store this is taken from the page origin.
# EXPO_PUBLIC_WEB_STORE_URL=https://shop.example.co.za

# Optional comma-separated allow-list for Yoco return URLs (Edge Function secret, not this file):
# ALLOWED_RETURN_ORIGINS=https://shop.example.co.za,http://localhost:8081

# Backend base URL when a separate payment API exists. Not required for the Supabase functions.
EXPO_PUBLIC_API_BASE_URL=

# --- Supabase Edge Function secrets (supabase secrets set …). NEVER commit values. ---
# These are not Vercel variables.
# YOCO_SECRET_KEY=sk_test_...
# YOCO_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY is injected into Edge Functions by Supabase.
#
# Switch test → live: docs/WEB_STORE.md
# 1. Replace YOCO_SECRET_KEY with sk_live_…
# 2. Replace EXPO_PUBLIC_YOCO_PUBLIC_KEY with pk_live_…
# 3. Register a new webhook and replace YOCO_WEBHOOK_SECRET
# 4. Set EXPO_PUBLIC_PAYMENTS_MODE=live and rebuild the web export

# From `eas init` / expo.dev project settings
EXPO_PUBLIC_EAS_PROJECT_ID=

# --- Local EAS / submit helpers (not baked into the binary; use EAS Secrets or shell env) ---
# EXPO_TOKEN=
# EXPO_APPLE_ID=
# EXPO_APPLE_APP_SPECIFIC_PASSWORD=
# ASC_API_KEY_PATH=
# ASC_API_KEY_ID=
# ASC_API_KEY_ISSUER_ID=
